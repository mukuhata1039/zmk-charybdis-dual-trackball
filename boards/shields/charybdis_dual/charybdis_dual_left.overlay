#include "charybdis_dual.dtsi"

#include <zephyr/dt-bindings/gpio/gpio.h>

/*
 * XIAO nRF52840:
 *
 * D4 = P0.4
 * D5 = P0.5
 *
 * EC11はD4/D5にGPIO_INT_EDGE_BOTHを設定している。
 *
 * P0.4/P0.5のEDGE割り込みを通常GPIOTEではなく、
 * nRF52840の低電力GPIO SENSEで処理させる。
 *
 * BIT(4) | BIT(5)
 * 0x10   | 0x20
 *       = 0x30
 */
&gpio0 {
    sense-edge-mask = <0x30>;
};

/*
 * XIAO標準のI2C1もP0.4/P0.5を使う。
 *
 * 今回はD4/D5をEC11専用として使うので、
 * I2C側からピン設定を変更されないよう無効化する。
 */
&i2c1 {
    status = "disabled";
};

/ {
    chosen {
        zmk,kscan = &kscan0;
    };

    /*
     * キー用Charlieplex
     *
     * D0 / D1 / D2 = Matrix
     * D3 = Key Wake Interrupt
     */
    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-charlieplex";
        wakeup-source;

        gpios =
            <&xiao_d 0 GPIO_ACTIVE_HIGH>,
            <&xiao_d 1 GPIO_ACTIVE_HIGH>,
            <&xiao_d 2 GPIO_ACTIVE_HIGH>;

        interrupt-gpios =
            <&xiao_d 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
    };
};

/*
 * Encoder
 *
 * D4 = A
 * D5 = B
 *
 * 通常スクロールとdeep sleep Wakeを
 * 同じD4/D5で行う。
 */
&left_encoder {
    status = "okay";
};
