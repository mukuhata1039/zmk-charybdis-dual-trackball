#include "charybdis_dual.dtsi"

#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
    };

    /*
     * 通常のキー入力
     * D0 / D1 / D2 = Charlieplex
     * D3 = Wake用interrupt
     */
    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-charlieplex";
        wakeup-source;

        gpios =
            <&xiao_d 0 GPIO_ACTIVE_HIGH>,
            <&xiao_d 1 GPIO_ACTIVE_HIGH>,
            <&xiao_d 2 GPIO_ACTIVE_HIGH>;

        interrupt-gpios =
            <&xiao_d 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
    };

    /*
     * エンコーダー起床専用
     *
     * Encoder A/B
     *    ↓ ダイオードで合流
     * D6
     */
    encoder_wakeup_scan: encoder_wakeup_scan {
        compatible = "zmk,kscan-gpio-direct";
        wakeup-source;

        input-gpios =
            <&xiao_d 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
    };

    /*
     * D6は通常キーとして使わずWake専用。
     */
    encoder_wakeup: encoder_wakeup {
        compatible = "zmk,kscan-sideband-behaviors";

        kscan = <&encoder_wakeup_scan>;

        auto-enable;
        wakeup-source;
    };
};

/*
 * 右側を全体matrixの後半として扱う。
 */
&default_transform {
    col-offset = <3>;
};

/*
 * 右ホイール
 *
 * 共有DTSのEC11定義を
 * 右XIAOでも使用する。
 *
 * D4 = A
 * D5 = B
 */
&left_encoder {
    status = "okay";
};
