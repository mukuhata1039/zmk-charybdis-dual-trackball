#define ZMK_POINTING_DEFAULT_SCRL_VAL 500

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/*
 * スクロールホイール
 *
 * 1ノッチを即座に処理して、
 * 高速回転してもキューを溜めない。
 */
&msc {
    trigger-period-ms = <2>;
};

/ {
    behaviors {
        mouse_scrl: mouse_wheel_scrl {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;

            bindings = <&msc>, <&msc>;

            tap-ms = <3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                /* LEFT */
                &kp A
                &kp B
                &kp C
                &kp D
                &kp E
                &kp F

                /* RIGHT */
                &kp G
                &kp H
                &kp I
                &kp J
                &kp K
                &kp L
            >;

            sensor-bindings = <
                &mouse_scrl SCRL_UP SCRL_DOWN
            >;
        };
    };
};
